{
  "name": "furtalk-widget",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Framework-neutral embeddable Furtalk comment widget custom element",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check src package.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cap-widget": "^0.1.56",
    "lit": "^3.3.3",
    "markdown-it": "^15.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.20.1",
    "eslint": "^9.20.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
