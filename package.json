{
  "name": "furtalk-widget",
  "version": "0.1.0",
  "type": "module",
  "description": "Furtalk 评论组件",
  "main": "./dist/furtalk.js",
  "exports": "./dist/furtalk.js",
  "unpkg": "./dist/furtalk.min.js",
  "jsdelivr": "./dist/furtalk.min.js",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GoodBoyboy666/furtalk-widget.git"
  },
  "scripts": {
    "dev": "vite build --mode unminified --watch",
    "build": "vite build --mode unminified && vite build --mode minified",
    "prepack": "npm run build",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check src package.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cap-widget": "^0.1.56",
    "lit": "^3.3.3",
    "markdown-it": "^15.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.20.1",
    "eslint": "^9.20.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
